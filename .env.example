# Slack — in production this is the same shared app as Tempus/Munus/Legion.
# Bot scopes needed: chat:write, im:write. The signing secret verifies inbound requests.
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
# Where "a review cycle just opened" announcements go (channel ID like C0ABCDE123;
# blank = off). Invite the bot to it first. Per-person reminders are DMs and don't
# need this.
SLACK_ANNOUNCE_CHANNEL=

# ── Legion SSO + roster ──────────────────────────────────────────────────────
# Every page is gated by Legion's shared `mw_sso` cookie. /admin needs the
# `virtus-admin` (full) or `virtus-manager` (team goals, cycles, dashboard — no
# competencies/roster/settings/backup/audit) group; the portal is open to any active
# roster member. Writing a review needs *neither* group — it comes from being the
# assigned reviewer, so a student subteam lead can review their members.
# There is no local admin password — grant the first admin `virtus-admin` in Legion's
# /admin/groups. SSO_SECRET must be identical to Legion's; add virtus.marswars.org to
# Legion's SSO_ALLOWED_RETURN_HOSTS or the return_to redirect back to Virtus is rejected.
SSO_SECRET=must-match-legion-sso-secret
SSO_SESSION_TTL=43200
SSO_COOKIE_DOMAIN=

# Legion roster API (read-only source of truth) + the one-tap SSO challenge endpoint.
# Must match the value Legion has configured as its VIRTUS_API_KEY.
LEGION_BASE_URL=https://legion.example.org
LEGION_API_KEY=must-match-legions-virtus-api-key

# Database
DATABASE_URL=sqlite+aiosqlite:///./virtus.db

# Localisation
TIMEZONE=America/New_York

# Public base URL used in Slack messages that link back to Virtus.
# Production: https://virtus.marswars.org
BASE_URL=http://localhost:8006

# The season new goals and cycles default to, and what the boards group by.
CURRENT_SEASON=2026

# Start DMing people who still owe a review this many days before a cycle closes.
# 0 disables the reminder job entirely.
REVIEW_REMINDER_DAYS=3

# How many personal development goals each student must keep on file per season. The
# portal nags them until they hit it, and a self-review can't be submitted while short.
# 0 turns the requirement off.
REQUIRED_PERSONAL_GOALS=2

# Database backups (SQLite only)
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_TIME=23:30
BACKUP_DAY=sun

# Master switch for automated Slack messages and scheduled jobs
UPDATES_ENABLED=true

# Dev / preview sign-in shim. Leave BLANK in production. When set, mounts `/dev-login`,
# which mints an `mw_sso` cookie for this host (needed only where Legion's real
# `.marswars.org` cookie can't reach). Every request must pass this exact value:
#   /dev-login?key=<this>&code=<member_code>&groups=virtus-admin
DEV_LOGIN_SECRET=
